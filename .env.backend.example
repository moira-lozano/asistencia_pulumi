# Ejemplo: cliente 192.168.1.20, backend 192.168.1.30. Ajustar a tu red.
BACKEND_HOST=192.168.1.30
PORT=8090
# Orígenes exactos desde los que se abre el cliente (incluye el puerto).
# Para otra máquina agrega, por ejemplo, http://192.168.1.20
FRONTEND_ORIGINS=http://192.168.1.20
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=asistencia
DB_PASSWORD=tu_clave_mysql
DB_NAME=uagrm_asistencia
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_clave_por_una_propia
INSTITUTION_TIMEZONE=America/La_Paz

# Solo para API detras de Nginx: IP o red del proxy de confianza. Vacio para acceso directo.
TRUSTED_PROXIES=192.168.1.20
